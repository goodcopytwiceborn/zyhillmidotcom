---
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Moved</title>
<meta http-equiv="refresh" content="0; url={{ r.to }}">
<link rel="canonical" href="{{ r.to }}">
<script>location.replace("{{ r.to }}" + location.hash);</script>
</head>
<body><p>This page moved to <a href="{{ r.to }}">{{ r.to }}</a>.</p></body>
</html>
