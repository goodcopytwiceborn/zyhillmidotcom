{%- set projects = collections.projects -%}
{%- if view == "project" -%}{%- set currentNodes = nodes -%}{%- elif view == "node" -%}{%- set currentNodes = [node.slug] -%}{%- else -%}{%- set currentNodes = [] -%}{%- endif -%}

{%- macro statusTag(s) -%}<span class="status status--{{ s }}">[{{ s | statusLabel }}]</span>{%- endmacro -%}

{%- macro tagList(list) -%}
{%- if list and list.length -%}
<ul class="tags" aria-label="Suggested tags">
{%- for t in list %}<li class="tag">#{{ t }}</li>{% endfor -%}
</ul>
{%- endif -%}
{%- endmacro -%}

{%- macro nodeTile(n, projects) -%}
<li class="tile">
  <a class="tile-link" href="/nodes/{{ n.slug }}/" data-swap>
    <span class="tile-box" aria-hidden="true"></span>
    <span class="tile-title">{{ n.question }}</span>
  </a>
  {{ tagList(n.tags or (projects | nodeTags(n.slug))) }}
</li>
{%- endmacro -%}

{%- macro tile(p) -%}
{#- Thumbnails are plain boxes for now: white, black 1px border, nothing inside (Zanyiah, 2026-11-12).
    Covers chosen so far (cover: in front matter, Are.na first images) are kept in the data for later. -#}
<li class="tile" data-status="{{ p.data.status }}">
  <a class="tile-link" href="{{ p.url }}" data-swap>
    <span class="tile-box" aria-hidden="true"></span>
    <span class="tile-title">{{ p.data.title }}</span>
  </a>
  {{ tagList(p.data.tags) }}
</li>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {#- Tab title: the Index section and the item — "Work in Progress — The Oz", "Nodes — How is work…";
      a section filter alone on the home page ("Work in Progress", set by swap.js); otherwise "Zanyiah Hill-Milling — Body of Work". -#}
  {%- set pageTitle -%}{% if view == "project" %}{{ (sections | sectionByKey(status)).title }} — {{ title }}{% elif view == "node" %}Nodes — {{ node.question }}{% elif view == "about" %}{{ title }}{% else %}{{ site.homeTitle }}{% endif %}{%- endset %}
  {%- set pageDesc -%}{% if view == "project" %}{{ content | excerpt }}{% elif view == "node" %}{{ node.description | trim }}{% elif view == "about" %}{{ site.readmeDescription }}{% else %}{{ site.homeDescription }}{% endif %}{%- endset %}
  <title>{{ pageTitle }}</title>
  {#- Search engines and link previews (LinkedIn, iMessage, etc.) -#}
  <meta name="description" content="{{ pageDesc }}">
  <meta name="author" content="{{ site.person }}">
  {#- Google Search Console ownership check for https://www.zyhillmi.com/ -#}
  <meta name="google-site-verification" content="JHToN9c2iBPmEEHADFh5V6TTjLCdAO2y2XyQyhag2nE">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if view == 'home' %}website{% else %}article{% endif %}">
  <meta property="og:site_name" content="{{ site.homeTitle }}">
  <meta property="og:title" content="{% if view == 'home' %}{{ pageTitle }}{% else %}{{ pageTitle }} — {{ site.person }}{% endif %}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary">
  {%- if view == "home" %}
  {#- Tells search engines this site, LinkedIn and Are.na are the same person. -#}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@graph":[
    {"@type":"Person","@id":"{{ site.url }}/#zanyiah","name":"{{ site.person }}","alternateName":["zyhillmi","Zanyiah"],"url":"{{ site.url }}/","description":"{{ site.homeDescription }}","sameAs":[{% for pl in site.platforms %}{% if pl.external and pl.url %}{% if not loop.first %},{% endif %}"{{ pl.url }}"{% endif %}{% endfor %}]},
    {"@type":"WebSite","@id":"{{ site.url }}/#website","name":"Body of Work","alternateName":"{{ site.homeTitle }}","url":"{{ site.url }}/","author":{"@id":"{{ site.url }}/#zanyiah"}}
  ]}
  </script>
  {%- endif %}
  {#- Tab icon: a plain lime-green square. SVG for modern browsers, PNG fallbacks. -#}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400;0,700;1,400&display=swap">
  <link rel="stylesheet" href="/assets/site.css">
  <script>document.documentElement.classList.add("js");</script>
  <script src="/assets/mockup.js" defer></script>
  <script src="/assets/swap.js?v=18" defer></script>
</head>
<body data-view="{{ view }}" data-home-state="{{ homeState or '' }}" data-font="mono" data-meta="mono" data-bio="a">
  <a class="skip" href="{% if view == 'home' %}#col1{% else %}#col2{% endif %}">Skip to content</a>

  {#- Breadcrumbs: Zanyiah (plain text) / Index / section / page.
      Index is highlighted on the landing page (About open). The Index crumb on inner pages
      returns to the landing page (About open); section crumbs open only that section there. -#}
  {%- set isLanding = view == "home" and homeState != "index" -%}
  {#- Full name on the landing page; just the first name once the trail goes deeper. -#}
  {%- set crumbs = [{ label: ("ZANYIAH HILL-MILLING" if view == "home" else "ZANYIAH"), plain: true }, { label: "Index", href: "/", current: view == "home" }] -%}
  {%- if view == "node" -%}
    {%- set crumbs = crumbs.concat([{ label: "Nodes", href: "/#sec-nodes" }, { label: node.question, current: true }]) -%}
  {%- elif view == "project" -%}
    {%- set statusSection = sections | sectionByKey(status) -%}
    {%- set crumbs = crumbs.concat([{ label: statusSection.title, href: "/#sec-" ~ statusSection.key }, { label: title, current: true }]) -%}
  {%- elif view == "about" -%}
    {%- set crumbs = crumbs.concat([{ label: "ReadMe!", current: true }]) -%}
  {%- endif %}
  <header class="masthead" id="masthead">
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        {%- for c in crumbs %}
        <li>{% if c.current %}<span aria-current="page">{{ c.label }}</span>{% elif c.plain %}<span>{{ c.label }}</span>{% else %}<a href="{{ c.href }}" data-swap>{{ c.label }}</a>{% endif %}{% if not loop.last %}<span class="crumb-sep" aria-hidden="true"> / </span>{% endif %}</li>
        {%- endfor %}
      </ol>
    </nav>
    {#- External links, right side of the bar. URLs come from _data/site.js. -#}
    <nav aria-label="Elsewhere">
      <ul class="sitebar-links">
        {%- for pl in site.platforms %}{% if pl.label != "Email" %}
        <li>{% if pl.url %}<a class="external" href="{{ pl.url }}" target="_blank" rel="noopener">{{ pl.label }}<span class="vh"> (opens in new tab)</span></a>{% else %}{% pending pl.label %}{% endif %}<span class="arrow" aria-hidden="true">↗</span></li>
        {%- endif %}{% endfor %}
      </ul>
    </nav>
  </header>

  <div class="index">
    {# ── Column 1 · collapsible sections (ref 11 rows, + instead of arrow) ── #}
    <nav class="col col1" id="col1" aria-label="Index">
      <details class="sec" id="sec-about" {% if isLanding %}open{% endif %}>
        <summary><span class="sec-title">ReadMe!</span><span class="sec-icon" aria-hidden="true"></span></summary>
        <div class="sec-body">
          {% include "bio.njk" %}
        </div>
      </details>
      {%- for s in sections %}
      {#- is-current: the section holding the node/project on screen (its + spins while closed) -#}
      {%- set isCur = (view == 'node' and s.key == 'nodes') or (view == 'project' and status == s.key) %}
      {#- The section holding the open project/node stays open, so the list is right there to keep going. -#}
      <details class="sec{% if isCur %} is-current{% endif %}" id="sec-{{ s.key }}"{% if isCur %} open{% endif %}>
        <summary><span class="sec-title">{{ s.title }}</span><span class="sec-icon" aria-hidden="true"></span></summary>
        <ul class="sec-list">
          {%- if s.key == "nodes" %}
          {%- for n in nodeIndex %}
          <li><a href="/nodes/{{ n.slug }}/" data-swap {% if view == "node" and node.slug == n.slug %}aria-current="page"{% endif %}><span class="sec-label">{{ n.question }}</span></a></li>
          {%- endfor %}
          {%- else %}
          {%- for p in projects | withStatus(s.key) %}
          <li><a href="{{ p.url }}" data-swap {% if view == "project" and page.url == p.url %}aria-current="page"{% endif %}><span class="sec-label">{{ p.data.title }}</span></a></li>
          {%- endfor %}
          {%- endif %}
        </ul>
      </details>
      {%- endfor %}
    </nav>

    {# ── Column 2 · text (hidden on the landing page; appears when a node or project is opened) ── #}
    <main class="col col2" id="col2" tabindex="-1">
      {%- if view == "home" %}
      {#- empty on the landing page -#}
      {%- elif view == "node" %}
      <h1>{{ node.question }}</h1>
      <p class="node-desc">{{ node.description }}</p>
      <h2 class="label">Connections</h2>
      <ul class="connections">
        {%- for p in projects | inNode(node.slug) %}
        <li><a class="internal" href="{{ p.url }}" data-swap>{{ p.data.title }}</a></li>
        {%- endfor %}
      </ul>

      {%- elif view == "project" %}
      <h1>{{ title }}</h1>
      <div class="pmeta">
        {{ tagList(tags) }}
        <ul class="pnodes">
          {%- for ns in nodes %}{% set nn = nodeIndex | nodeBySlug(ns) %}
          <li><a class="internal" href="/nodes/{{ nn.slug }}/" data-swap>{{ nn.question }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <div class="prose">
        {%- if copyInMockup %}
        {{ content | safe }}
        {%- else %}
        <p class="note">[Project copy not included in this layout mockup. It stays in content/website-content.txt and will be added in the full build.]</p>
        {%- endif %}
      </div>

      {%- elif view == "about" %}
      <div class="prose about">{{ content | safe }}</div>
      {%- endif %}

      {%- if view != "home" %}
      <p class="to-index"><a href="#col1">↓ Index</a></p>
      {%- endif %}
    </main>

    {# ── Column 3 · Are.na gallery ── #}
    <aside class="col col3" id="col3" aria-label="Gallery">
      {%- if view == "home" %}
      {#- Filtered by the open section (see swap.js): Recent Work / Work in Progress / Archive show
          only those projects; Nodes swaps to the node tiles. -#}
      <ul class="tiles" id="gallery-projects">{% for p in projects | recentFirst %}{{ tile(p) }}{% endfor %}</ul>
      <ul class="tiles" id="gallery-nodes" aria-label="Nodes" hidden>{% for n in nodeIndex %}{{ nodeTile(n, projects) }}{% endfor %}</ul>

      {%- elif view == "node" %}
      <ul class="tiles" aria-label="Other nodes">
        {#- Start with the next node and wrap around, so the first tile always steps forward: 01 → 02 → … → 07 → 01. -#}
        {%- for n in nodeIndex | othersFrom(node.slug) %}{{ nodeTile(n, projects) }}{% endfor %}
      </ul>

      {%- elif view == "project" %}
        {#- Related projects only for a project confirmed to have no Are.na channel (`noChannel: true`). -#}
        {%- if gallery and gallery.length %}
        {#- Zanyiah's own images for this project (site/src/assets/work/<slug>/), in her order. -#}
        <ul class="gallery gallery--photos">
          {%- for g in gallery %}
          <li class="item item--image">
            {#- Photos show bare: no caption, no border (Zanyiah, 2026-11-12). Date/credit stay in the data for later hover details. -#}
            <img src="{{ g.src }}" alt="{{ g.alt }}" loading="{% if loop.index > 2 %}lazy{% else %}eager{% endif %}" decoding="async">
          </li>
          {%- endfor %}
        </ul>
        {%- elif arenaChannels[slug] and arenaChannels[slug].items.length %}
        {%- set ch = arenaChannels[slug] %}
        {#- The project's Are.na channel, fetched at build time (src/_data/arenaChannels.js): latest 20 blocks,
            in Are.na's order. Photos show bare; title and source appear on hover/focus. -#}
        <ul class="gallery gallery--arena">
          {%- for it in ch.items %}
          <li class="item item--{{ it.kind }}">
            <a class="arena-item" href="{{ it.href }}" target="_blank" rel="noopener">
              {%- if it.kind == "image" %}
              <img src="{{ it.img.src }}" srcset="{{ it.img.src }} 1x, {{ it.img.src2x }} 2x" width="{{ it.img.width }}" height="{{ it.img.height }}" alt="{{ it.alt }}" loading="{% if loop.index > 4 %}lazy{% else %}eager{% endif %}" decoding="async">
              {%- elif it.kind == "text" %}
              <span class="arena-text">{{ it.text }}</span>
              {%- elif it.kind == "file" %}
              <span class="arena-card"><span class="arena-card-kind">{{ it.fileLabel }}</span>{{ it.title or "Attachment" }}</span>
              {%- elif it.kind == "channel" %}
              <span class="arena-card"><span class="arena-card-kind">Channel</span>{{ it.title }}</span>
              {%- else %}
              <span class="arena-card"><span class="arena-card-kind">Link</span>{{ it.title or it.sourceName }}</span>
              {%- endif %}
              {%- if it.title or it.sourceName %}
              <span class="arena-info">{% if it.title %}<span class="arena-info-title">{{ it.title }}</span>{% endif %}{% if it.sourceName %}<span class="arena-info-source">{{ it.sourceName }} ↗</span>{% endif %}</span>
              {%- endif %}
              <span class="vh"> (opens in new tab)</span>
            </a>
          </li>
          {%- endfor %}
        </ul>
        {%- elif noChannel %}
        <ul class="tiles" aria-label="Related projects in this node">{% for p in projects | related({ slug: slug, nodes: nodes }) %}{{ tile(p) }}{% endfor %}</ul>
        {%- else %}
        {#- No photos and no Are.na channel yet: the gallery column stays empty. -#}
        {%- endif %}

      {%- elif view == "about" %}
      {#- ReadMe!: gallery column left empty for now (reference 17 travel photos later). -#}
      {%- endif %}
    </aside>

    {#- Spinning Are.na badge (after e-flux's SHOP disc; Are.na's own mark, from are.na): only on a project with an Are.na channel
        (`arena:` in its front matter), linking to that channel. The slot is swapped by swap.js. -#}
    <div id="arena-slot" class="arena-slot">
    {%- if view == "project" and arena %}
    <a class="arena-badge" href="{{ arena }}" target="_blank" rel="noopener" aria-label="This project’s Are.na channel (opens in new tab)">
      <svg class="arena-badge-mark" viewBox="0 0 150.38 88.986" aria-hidden="true" focusable="false"><path d="M148.93 62.356l-20.847-16.384c-1.276-1-1.276-2.642 0-3.645l20.848-16.38c1.28-1.002 1.815-2.695 1.19-3.76-.626-1.062-2.374-1.44-3.88-.84l-24.79 9.874c-1.507.606-2.927-.22-3.153-1.83L114.57 2.926C114.34 1.317 113.13 0 111.877 0c-1.247 0-2.456 1.317-2.68 2.925l-3.73 26.467c-.228 1.61-1.646 2.434-3.155 1.83l-24.38-9.71c-1.512-.602-3.975-.602-5.483 0l-24.384 9.71c-1.508.604-2.928-.22-3.154-1.83L41.186 2.925C40.956 1.317 39.748 0 38.5 0c-1.252 0-2.463 1.317-2.688 2.925l-3.73 26.467c-.226 1.61-1.645 2.434-3.153 1.83L4.14 21.35c-1.507-.603-3.252-.223-3.878.838-.625 1.066-.092 2.76 1.184 3.76l20.85 16.38c1.277 1.003 1.277 2.645 0 3.646L1.446 62.356C.166 63.358-.364 65.152.26 66.34c.627 1.19 2.372 1.668 3.877 1.064l24.567-9.866c1.51-.603 2.914.218 3.125 1.828l3.544 26.696c.214 1.607 1.618 2.923 3.12 2.923 1.5 0 2.905-1.315 3.12-2.923l3.55-26.696c.21-1.61 1.62-2.43 3.122-1.828l24.164 9.698c1.506.606 3.97.606 5.477 0l24.16-9.698c1.504-.603 2.91.218 3.125 1.828l3.55 26.696c.212 1.607 1.617 2.923 3.115 2.923 1.502 0 2.907-1.315 3.12-2.923l3.55-26.696c.216-1.61 1.62-2.43 3.124-1.828l24.57 9.866c1.5.604 3.25.125 3.876-1.063.627-1.186.094-2.98-1.185-3.982zM95.89 46.18L77.53 60.315c-1.285.99-3.393.99-4.674 0L54.49 46.18c-1.284-.99-1.294-2.62-.02-3.625l18.4-14.493c1.274-1.005 3.363-1.005 4.638 0l18.4 14.493c1.277 1.004 1.267 2.634-.02 3.626z"/></svg>
    </a>
    {%- endif %}
    </div>
  </div>

  {%- if site.mockup %}
  <section class="mockbar" aria-label="Mockup controls">
    <span class="mockbar-label">Mockup</span>
    <div class="seg" role="group" aria-label="Bio draft">
      <span>Bio</span>
      <button type="button" data-set="bio" data-value="a" aria-pressed="true">A</button>
      <button type="button" data-set="bio" data-value="b" aria-pressed="false">B</button>
    </div>
    <div class="seg" role="group" aria-label="Typeface">
      <span>Type</span>
      <button type="button" data-set="font" data-value="mono" aria-pressed="true">Mono</button>
      <button type="button" data-set="font" data-value="arimo" aria-pressed="false">Arimo</button>
      <button type="button" data-set="font" data-value="system" aria-pressed="false">System</button>
    </div>
    <div class="seg" role="group" aria-label="Metadata style">
      <span>Meta</span>
      <button type="button" data-set="meta" data-value="mono" aria-pressed="true">Mono</button>
      <button type="button" data-set="meta" data-value="sans" aria-pressed="false">Sans</button>
    </div>
    <p class="legend"><span>Links:</span>
      <a class="external" href="https://research-repository.uwa.edu.au/en/publications/familygoals-family-influencers-calibrated-amateurism-and-justifyi/" target="_blank" rel="noopener">external<span class="vh"> (opens in new tab)</span></a><span aria-hidden="true" class="arrow">↗</span>
      <a class="internal" href="/">internal</a>
      {% pending "pending" %}
    </p>
  </section>
  {%- endif %}
</body>
</html>
